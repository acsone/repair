<odoo>

    <record id="res_config_settings_form_view" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-string="repair"
                    string="Repairs"
                    data-key="repair"
                    groups="stock.group_stock_manager"
                >
                    <h2>Repairs — Preparation</h2>

                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="repair_preparation_enabled" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="repair_preparation_enabled" />
                                <div class="text-muted">
                                    If enabled, the system creates internal
                                    transfers to stage parts in a Preparation
                                    location
                                    and enforces completion of these pickings
                                    before finishing repairs.
                                </div>
                            </div>
                        </div>

                        <div
                            class="col-12 col-lg-6 o_setting_box"
                            attrs="{'invisible': [('repair_preparation_enabled', '=', False)]}"
                        >
                            <div class="o_setting_left_pane">

                            </div>
                            <div class="o_setting_right_pane">
                                <field
                                    name="repair_preparation_picking_type_id"
                                    options="{'no_create': True}"
                                />
                                <div class="text-muted">
                                    Default Internal Transfer operation type
                                    used to bring parts from Stock to the
                                    Preparation area
                                    on new Repair Orders. You can still
                                    override it per repair.
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </xpath>
        </field>
    </record>


    <record id="action_repair_config_settings" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'repair', 'bin_size': False}</field>
        </record>
        <menuitem
        id="menu_repair_general_settings"
        name="Settings"
        parent="repair.repair_menu_config"
        sequence="0"
        action="action_repair_config_settings"
        groups="base.group_system"
    />


</odoo>
