<odoo>

    <record id="repair_order_form_view" model="ir.ui.view">
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='extra_info']//field[@name='move_id']"
                position="before"
            >
                <field name="preparation_group_id" />
            </xpath>
            <xpath expr="//field[@name='picking_id']" position="after">
                <field name="preparation_picking_type_id" required="True" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_preparation_picking"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-cart"
                >
                    Preparation
                </button>
                <button
                    name="action_view_move"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list"
                >
                    Stock Moves
                </button>
            </xpath>
        </field>
    </record>


</odoo>
